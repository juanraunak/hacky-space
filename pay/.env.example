# Copy to .env and fill in. Leave PINELABS_CLIENT_ID empty to stay in MOCK mode.

# Port the server listens on. Render sets this for you.
PORT=8787

# Where the game frontend lives. This is the only allowed CORS origin, and the
# browser is redirected here after checkout with ?paid=1 or ?paid=0
FRONTEND_URL=http://localhost:5173

# Public URL of THIS server, used to build the callback urls sent to Pine Labs.
# Must be reachable from the internet in real mode, e.g. https://space-pay.onrender.com
# Use an ngrok/cloudflared tunnel when testing locally.
PUBLIC_URL=http://localhost:8787

# ---- Pine Labs Online (Plural). Server side only, never ship to the client ----

# UAT/sandbox: https://pluraluat.v2.pinepg.in
# Production:  https://api.pluralonline.com
PINELABS_BASE_URL=https://pluraluat.v2.pinepg.in

# Set these two to switch out of MOCK mode into REAL mode.
PINELABS_CLIENT_ID=
PINELABS_CLIENT_SECRET=

# Webhook secret key from the Pine Labs Online dashboard, under Settings.
# Base64 value, used to verify the webhook-signature header.
PINELABS_WEBHOOK_SECRET=
