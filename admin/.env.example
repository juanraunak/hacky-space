# Copy to .env and fill in. .env is gitignored: the key never leaves this machine.

# AgenticOrg API key with the agents:run scope. Server side only.
AGENTICORG_API_KEY=

# Hackathon server. Must be set: the SDK default (app.agenticorg.ai) is the wrong one.
AGENTICORG_BASE_URL=https://agenticorg.hackathon.pinelabs.com

# Local port for the admin page. It only listens on 127.0.0.1.
PORT=8790
